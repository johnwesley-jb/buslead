# Copy to `.env` and fill in the values. NEVER commit `.env` and never paste its contents into chat.
# Generate secrets with:   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Encryption key (32 bytes, base64):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development
PORT=4000

# Where the dashboard runs. Used for CORS, CSRF origin checks and the post-OAuth redirect.
FRONTEND_ORIGIN=http://localhost:5173

# Public HTTPS URL of THIS API as Vapi sees it (your ngrok/Cloudflare tunnel). Only used to show you the webhook URL.
PUBLIC_API_URL=https://replace-me.ngrok-free.app

# Number of reverse proxies in front of the API (ngrok/Vite proxy = 1). Wrong values weaken IP rate limiting.
TRUST_PROXY=1

# --- Database / queue (matches docker-compose.yml; change the password in BOTH places) ---
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://buslead:change-me-local-only@localhost:5432/buslead?schema=public
REDIS_URL=redis://localhost:6379

# --- Secrets (each at least 32 chars; different values) ---
SESSION_SECRET=
ENCRYPTION_KEY=

# Session lifetime. Absolute cap and idle timeout.
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Leave empty for automatic (Secure cookies in production). Set to true when serving the dashboard over HTTPS.
COOKIE_SECURE=

# --- Vapi ---
VAPI_API_KEY=
# The Bearer token you create under Vapi -> Credentials -> Custom Credential (Bearer). 32+ random chars.
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Hosts the recording proxy may fetch from (comma-separated; ".example.com" matches subdomains).
RECORDING_HOST_ALLOWLIST=storage.vapi.ai,.vapi.ai

# --- Google Calendar (OAuth client of type "Web application") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback
# Personal Gmail with the OAuth app in "Testing": Google expires refresh tokens after 7 days.
GOOGLE_OAUTH_TESTING_MODE=true

# --- Behaviour ---
# Automatically book the earliest open slot for leads that have contact details but no appointment.
AUTO_ASSIGN_UNBOOKED=true

# --- First admin (used by `npm run admin:create`) ---
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
